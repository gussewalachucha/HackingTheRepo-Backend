# MongoDB
MONGO_URI=mongodb://localhost:27017/repomind

# JWT (required in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Encrypts stored GitHub/Groq secrets at rest (falls back to JWT_SECRET)
ENCRYPTION_KEY=your_32_plus_char_encryption_key_here

# Allowed frontend origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# RepoMind Bot Config
# Fallback GitHub token for PR jobs when a user hasn't saved their own token in
# Settings. Needs push access to the target repos ("repo" scope for a classic
# token, or "Contents: Read and write" + "Pull requests: Read and write" for a
# fine-grained token; add "workflow" to change .github/workflows).
REPOMIND_GITHUB_TOKEN=ghp_your_bot_github_token_here
REPOMIND_GITHUB_USERNAME=your-bot-github-username

# No longer used: PR jobs now run inside this server (the RepoMind FastAPI
# service was removed). Safe to delete.
# REPOMIND_API_URL=http://localhost:8000

# Groq — used by the prompt assistant and by PR jobs (analyze + edit calls).
# Server keys are used after the user's own keys saved in Settings.
GROQ_API_KEY=
# Extra backup keys (comma-separated). When a key is expired, revoked or
# rate limited, the next one is used automatically.
# GROQ_API_KEYS=gsk_second_key,gsk_third_key
# Or keep the keys in a JSON file (gitignored), e.g. ["gsk_1", "gsk_2"]
# or {"0": "gsk_1"}. Default: backend/groq.json.
# GROQ_KEYS_FILE=groq.json
GROQ_MODEL=openai/gpt-oss-120b
# Groq vision model (via LangChain) that describes images attached to a job.
# Any Groq model with image input works; same free Groq keys as above.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Max tokens per image description (default 800; free plans cap output at
# about 1000 tokens per minute).
# GROQ_VISION_MAX_TOKENS=800
# Max output tokens per Groq call (default 8192). Lowered automatically when
# Groq reports a smaller tokens-per-minute limit.
# GROQ_MAX_OUTPUT_TOKENS=8192
# Output budget for each file the AI writes (default 16384). Requests are
# automatically fitted to your Groq plan's tokens-per-minute limit.
# GROQ_FILE_MAX_TOKENS=16384
# How hard gpt-oss models think on planning/writing (low | medium | high,
# default high; lowered automatically on small free-tier limits).
# GROQ_REASONING_EFFORT=high
# Files are written one AI call per file; "single" uses one call for all.
# PR_EDIT_MODE=
# Senior-review pass after writing (on by default; skipped automatically on
# plans under 20000 tokens/minute unless set to "true"; "false" turns it off).
# PR_REVIEW_PASS=

# PR jobs (all optional)
# Where repositories are cloned (default: backend/workspace, which is
# gitignored and ignored by nodemon). Each job gets <PR_WORKDIR>/<owner>-<repo>-<id>;
# every run of a job re-clones into that folder, and it is kept afterwards so
# you can inspect it. Deleting a job deletes its folder.
# PR_WORKDIR=
# Set to "true" to delete a job's clone as soon as the run finishes.
# PR_CLEANUP_WORKDIR=false
# How many jobs run at once; the rest wait in the queue (default 2).
# PR_MAX_CONCURRENT_JOBS=2
# Hard time limit per job run in milliseconds (default 900000 = 15 minutes).
# PR_JOB_TIMEOUT_MS=900000
# Characters of the make-folder-txt folder structure sent to Groq (default 12000).
# PR_STRUCTURE_CHARS=12000
# Characters of file contents sent to Groq per call (default 24000). Lower it
# for Groq free-tier models with small tokens-per-minute limits.
# PR_CONTEXT_CHARS=24000
# Largest file (in characters) the AI sees in full and may rewrite whole
# (default 40000). Bigger files are changed with find/replace edits, which
# fail more often; lower it if Groq reports requests as too large.
# PR_FILE_CHARS=40000

# GitHub OAuth (optional — enables Continue with GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

PORT=5000
NODE_ENV=development
